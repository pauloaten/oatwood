# ─────────────────────────────────────────────────────────────────────────────
# Woodcraft — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel this is set automatically. For production:
# NEXT_PUBLIC_SITE_URL=https://woodcraft.co.uk

# ── Newsletter (choose ONE provider) ─────────────────────────────────────────

# Mailchimp
# Get these from: mailchimp.com → Account → Extras → API Keys
# Server prefix = first part of your API key, e.g. "us21"
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=

# ConvertKit (alternative to Mailchimp)
# Get these from: app.convertkit.com → Settings → Developer
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ── Contact form ──────────────────────────────────────────────────────────────
# Resend — free tier: 3,000 emails/month
# Get key from: resend.com → API Keys
# Docs: resend.com/docs
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@woodcraft.co.uk

# ── Shopify (optional — replace static product data) ─────────────────────────
# Setup: Shopify admin → Apps → Develop apps → Create app → Storefront API
# Enable scopes: unauthenticated_read_product_listings, unauthenticated_write_checkouts
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Vercel Analytics — enable in Vercel dashboard, no key needed
# Google Analytics
NEXT_PUBLIC_GA_ID=
